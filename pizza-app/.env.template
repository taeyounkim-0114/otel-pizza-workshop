# Dash0 Configuration
# Get your token from: https://app.dash0.com → Settings → Auth Tokens

DASH0_AUTH_TOKEN=your_token_here

# Your Dash0 region endpoint
# Check your Dash0 URL to determine your region:
# - US West: https://ingress.us-west-2.aws.dash0.com:4317
# - EU West: https://ingress.eu-west-1.aws.dash0.com:4317
DASH0_ENDPOINT=https://ingress.us-west-2.aws.dash0.com:4317

# Which Dash0 dataset the telemetry lands in
DASH0_DATASET=default

# Tags every signal with deployment.environment.name so you can tell this stack
# apart from anything else reporting to the same dataset
DASH0_ENVIRONMENT=local

# Your fork's URL. Sent as the vcs.repository.url.full resource attribute, which
# is what lets Dash0 link telemetry back to this source code.
VCS_REPOSITORY_URL=https://github.com/dash0-community/otel-pizza-workshop

# Where the browser posts its telemetry. Leave empty to auto-detect (same host
# as the page, port 4318 — the Collector). Set it only if the browser cannot
# reach that port, e.g. DASH0_BROWSER_ENDPOINT=https://my-vm.example.com:4318
DASH0_BROWSER_ENDPOINT=

# service.name reported for the frontend
DASH0_WEBSITE_SERVICE_NAME=pizza-frontend

# Optional: Enable debugging scenarios
SLOW_KITCHEN=false
NO_DRIVERS=false
ERROR_RATE=0
